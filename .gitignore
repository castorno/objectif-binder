# --- OS / Editors ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# --- Environment / secrets ---
# .env itself IS committed (Symfony/Vite convention: non-secret defaults).
# Only local overrides, which may hold real secrets, are ignored.
.env.local
.env.*.local
*.local

# --- Backend (PHP / Symfony) ---
backend/vendor/
backend/var/
backend/.env.local
backend/.env.*.local
backend/public/bundles/
backend/config/secrets/*/*.decrypt.private.php

# --- Frontend (Node) ---
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/coverage/

# --- Docker ---
docker/data/

# --- Data that must never be committed (legal / licensing) ---
# Jeux de données de cartes importés/scrapés et images (matériel protégé)
**/var/import/
**/storage/cards/
*.sqlite
